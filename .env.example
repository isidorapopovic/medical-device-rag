# Local Ollama settings read by main.py and mdr_rag/
# App defaults only, not performance guarantees. Preserve any existing .env.
EMBEDDING_MODEL=embeddinggemma
OLLAMA_LLM_MODEL=qwen3:4b
# Positive context-window size supported by the chosen local model
OLLAMA_NUM_CTX=8192
# Optional: 0 requests CPU-only Ollama layers for reproducible CPU experiments.
# Blank preserves Ollama automatic device selection; actual execution must be checked.
OLLAMA_NUM_GPU=

# Retrieval settings
RETRIEVAL_MODE=hybrid
RERANK_ENABLED=false
# Blank preserves RERANK_ENABLED compatibility; explicit none/llm/cross_encoder wins.
RERANK_BACKEND=
# Optional separate local reranker (never downloaded during inference).
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
CROSS_ENCODER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
CROSS_ENCODER_MAX_TOKENS=512
CROSS_ENCODER_BATCH_SIZE=4
# Optional CROSS_ENCODER_CACHE defaults to reports/reranker-cache.
# Bounded review query planning (optional LLM selects sourced intents only)
MULTI_QUERY_ENABLED=true
QUERY_PLANNER=deterministic
MULTI_QUERY_MAX=4
RETRIEVAL_PER_QUERY=12
RETRIEVAL_MAX_CANDIDATES=30

# Review evidence gate: strict abstains until a matching human-label calibration exists.
EVIDENCE_GATE_MODE=strict
EVIDENCE_GATE_CALIBRATION=
# Only experimental mode reads this; supply an explicit finite value, never a universal default.
EVIDENCE_GATE_THRESHOLD=

# Label recorded with draft legal analyses
LEGAL_VERSION=UNSPECIFIED HISTORICAL TEXT

# Stage 01 local runtime guards (existing .env is never overwritten).
LLM_PROVIDER=ollama
CLOUD_LLM_ENABLED=false
# No cloud provider implementation is enabled by these settings.
OLLAMA_HOST=http://127.0.0.1:11434
RUNTIME_DATABASE=state/runtime.sqlite3
MAX_LLM_CALLS_PER_RUN=30
MAX_PROMPT_CHARS_PER_CALL=16000
MAX_OUTPUT_TOKENS_PER_CALL=1200
MAX_RUN_INPUT_TOKENS=120000
MAX_RUN_OUTPUT_TOKENS=16000
MAX_CLOUD_SPEND_USD=0
RUN_TIMEOUT_SECONDS=1200
MODEL_REQUEST_TIMEOUT_SECONDS=120
# At most two retries after the first attempt; every attempt consumes budget.
MAX_RETRIES=2
RETRY_BASE_SECONDS=0.25
RETRY_MAX_SECONDS=2
CIRCUIT_FAILURE_LIMIT=3
SQLITE_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
REQUIRE_HUMAN_REVIEW=true
OCR_ENABLED=false
